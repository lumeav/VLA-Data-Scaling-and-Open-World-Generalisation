%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% for beamer slides to include plain *.tex
% Slide with frametitle and framesubtitle
% #1 filename
% #2 frametitle
% #3 framesubtitle (no subtitle --> blank)
%
\newcommand{\bslide}[3]
{\begin{frame}[shrink]
	\frametitle{#2}
	\framesubtitle{#3}
	\input{#1}
	\end{frame}
	}	
	
