%Titelseite der Prsentation:

\defbeamertemplate*{title page}{myulm}[1][]{%
	\vspace{-0.16em}%
	\hbadness=10000\relax
	\noindent\makebox[\linewidth][l]{%
	\begin{tabular*}{\paperwidth}[b]{lp{23em}r}
		\vspace{-1.0em}
		\hspace*{-3.0em}
		\includegraphics[scale=0.4]{htwg_logo_in} & & \includegraphics[scale=0.7]{htwg_name_en}
		\vspace{1.0em}
	\end{tabular*}}
	\begin{beamercolorbox}[sep=8pt,left]{institute}
		\leftskip-2.58em%
		\vskip-0.8em
		\makebox[0pt][l]{\includegraphics[width=1.2\textwidth,height=0.368\textwidth]{\titleimage}}
	\end{beamercolorbox}
	\begin{beamercolorbox}[sep=8pt,right]{title}
		\leftskip-3em%
		\vskip-1.0em%
		\makebox[\linewidth][l]{%
		\begin{tabular*}{\dimexpr\paperwidth+4pt\relax}[b]{p{20em}p{20em}}
			& \usebeamerfont{title}\parbox{20em}{\inserttitle}\\%
			\hspace{0.3cm}
			\textcolor[rgb]{0,0,0}{\parbox[t]{18.5em}{\tiny \insertauthor}} %
			& {\usebeamerfont{subtitle}\parbox{20em}{\insertsubtitle}}\\%
		\end{tabular*}}
	\end{beamercolorbox}%
	\vfill}


% Part page: myulm 
\defbeamertemplate*{part page}{myulm }[1][]
{
  \begin{centering}
    {\usebeamerfont{part name}\usebeamercolor[fg]{part name}\partname~\insertromanpartnumber}
    \vskip1em\par
    \begin{beamercolorbox}[sep=8pt,center,#1]{part title}
      \usebeamerfont{part title}\insertpart\par
    \end{beamercolorbox}
  \end{centering}
} 
