\mode<presentation>
\usepackage{lastpage}
\setbeamercolor{frametitle}{parent=palette primary}

\AtBeginDocument{
  {
    \usebeamerfont*{headline}

		
	
    \usebeamercolor{normal text}
    \usebeamercolor{title in head/foot}
    \usebeamercolor{subsection in head/foot}
    \usebeamercolor{section in head/foot}
    \usebeamercolor{frametitle}

    
    \pgfdeclareverticalshading{beamer@aboveframetitle}{\the\paperwidth}{%
      color(0ex)=(frametitle.bg);%
      color(0ex)=(frametitle.bg);%
      color(0ex)=(subsection in head/foot.bg)
    }

    \pgfdeclareverticalshading{beamer@belowframetitle}{\the\paperwidth}{%
      color(0ex)=(normal text.bg);%
      color(0ex)=(frametitle.bg)
    }
  }
}

\defbeamertemplate*{headline}{myulm}{%
	\vspace{0.3cm}%
	\hbox{\makebox[0pt][l]{\textcolor{beamer@blendedblue}{\line(1,0){564}}}}%
	\hspace{-0.3cm}%
	\begin{tabular}[t]{cl}
		\textcolor[rgb]{1,1,1}{\colorbox{beamer@blendedblue}{\makebox[15ex]{%
		\ Slide \insertframenumber{}\ - \inserttotalframenumber{}} \hspace{0.5cm} \insertsection }} &
		\textcolor{beamer@blendedblue}{ \insertsubsection  \ \ \ }
	\end{tabular}%
	\vspace{0.1cm}}


\defbeamertemplate*{footline}{myulm}
  {%
  	\hspace{0.33cm}
		\textcolor[HTML]{808080}{  \parbox[c]{15cm}
       {  \tiny \insertshorttitle\ $\vert$ \insertshortauthor\ $\vert$ \presdatum\ $\vert$ \insertshortinstitute}}%
  	\vspace{0.1cm}
  

  }

\mode
<all>
